end

local function tween(object, goal, duration)
	tweenService:Create(
		object,
		TweenInfo.new(
			duration or 0.2,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		goal
	):Play()
end

local function makeWindow(frame, dragHandle, minSize, maxSize)
	frame.Draggable = false

	local moving, resizing = false, false
	local startInput, startPosition, startSize = nil, nil, nil

	local function isPointer(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	dragHandle.InputBegan:Connect(function(input)
		if isPointer(input) then
			moving = true
			startInput = input.Position
			startPosition = frame.Position
		end
	end)

	local grip = create("TextButton", {
		Size = UDim2.fromOffset(22, 22),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 10,
	}, frame)

	grip.InputBegan:Connect(function(input)
		if isPointer(input) then
			resizing = true
			startInput = input.Position
			startSize = frame.AbsoluteSize
		end
	end)

	table.insert(state.connections,
		userInputService.InputEnded:Connect(function(input)
			if isPointer(input) then
				moving = false
				resizing = false
			end
		end)
	)

	table.insert(state.connections,
		userInputService.InputChanged:Connect(function(input)
			local isMove =
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch

			if not isMove or not startInput then
				return
			end

			local delta = input.Position - startInput

			if moving then
				frame.Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
			elseif resizing then
				frame.Size = UDim2.fromOffset(
					math.clamp(startSize.X + delta.X, minSize.X, maxSize.X),
					math.clamp(startSize.Y + delta.Y, minSize.Y, maxSize.Y)
				)
			end
		end)
	)
end

local oldNamecall

local function disarm()
	if not state.capturing then
		return
	end

	state.capturing = false
	hookmetamethod(game, "__namecall", oldNamecall)
end

local function arm()
	if state.capturing or state.divergentArgs then
		return
	end

	state.capturing = true

	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if state.capturing
			and getnamecallmethod() == "FireServer"
			and typeof(self) == "Instance"
			and self.Parent == divergentRemotes
			and not checkcaller()
		then
			state.divergentRemote = self
			state.divergentArgs = table.pack(...)
			state.capturing = false

			task.defer(function()
				hookmetamethod(game, "__namecall", oldNamecall)
			end)
		end

		return oldNamecall(self, ...)
	end))
end

state.disarm = disarm

local function onAnimationPlayed(track)
	if not state.divergent
		or not state.divergentArgs
		or os.clock() < state.ignoreUntil
	then
		return
	end

	if not DIVERGENT_ANIMATIONS[track.Animation.AnimationId] then
		return
	end

	state.ignoreUntil = os.clock() + REPEAT_LOCKOUT

	local remote = state.divergentRemote
	local args = state.divergentArgs

	task.delay(REPEAT_DELAY, function()
		if state.divergent then
			pcall(remote.FireServer, remote, table.unpack(args, 1, args.n))
		end
	end)
end

