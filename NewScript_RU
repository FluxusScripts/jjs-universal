local function setMenuVisible(visible)
	openButton.Text = visible and "×" or "≡"

	if visible then
		menu.Visible = true

		local target = menu.Size

		menu.Size = UDim2.new(
			target.X.Scale,
			target.X.Offset - 30,
			target.Y.Scale,
			target.Y.Offset - 20
		)

		menu.BackgroundTransparency = 1

		tween(menu, {
			Size = target,
			BackgroundTransparency = 0,
		}, 0.2)
	else
		menu.Visible = false
	end
end

