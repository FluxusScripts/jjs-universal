        local count = countActiveDomains()

        domainStatus.Text = "Домэйны: " .. count

        if count > 0 then
            domainStatus.BackgroundColor3 = SECONDARY_CONTAINER
            domainStatus.TextColor3 = ON_SECONDARY_CONTAINER
        else
            domainStatus.BackgroundColor3 = PRIMARY_CONTAINER
            domainStatus.TextColor3 = ON_PRIMARY_CONTAINER
