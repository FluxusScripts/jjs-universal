local notifyToken = 0

local function notify(message)
    notifyToken += 1
    local token = notifyToken

    notifyLabel.Text = message
    notifyLabel.Visible = true

    task.delay(2.5, function()
        if notifyToken == token then
            notifyLabel.Visible = false
        end
    end)
end

local function getDomainColliders()
    local results = {}
    local domainsFolder = workspace:FindFirstChild("Domains")

    if not domainsFolder then
        return results
    end

    for _, domain in ipairs(domainsFolder:GetChildren()) do
        if domain.Name == "Domain" then
            local collider = domain:FindFirstChild("DomainCollider", true)

            if collider and collider:IsA("BasePart") then
                table.insert(results, {
                    domain = domain,
                    collider = collider,
                })
            end
        end
    end

    table.sort(results, function(a, b)
        local pa = a.collider.Position
        local pb = b.collider.Position

        if pa.X ~= pb.X then
            return pa.X < pb.X
        end

        if pa.Z ~= pb.Z then
            return pa.Z < pb.Z
        end

        return pa.Y < pb.Y
    end)

    return results
end

local function teleportToCollider(collider)
    if not collider or not collider.Parent then
        notify("Домэйн уже исчез")
        return
    end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        notify("Персонаж не найден")
        return
    end

    local destination = collider.Position
        + Vector3.new(0, collider.Size.Y / 2 + 4, 0)

    root.CFrame = CFrame.new(destination)
    noticePanel.Visible = false
end

local function openDomainSelector()
    local domains = getDomainColliders()

    clearDomainRows()

    if #domains == 0 then
        notify("Активные DomainCollider не найдены")
        noticePanel.Visible = false
        return
    end

    noticePanel.Size = UDim2.fromOffset(
        280,
        math.min(180, 54 + #domains * 42)
    )

    for index, entry in ipairs(domains) do
        local position = entry.collider.Position

        local row = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = PRIMARY_CONTAINER,
            Text = string.format(
                "Domain %d  (%.0f, %.0f, %.0f)",
                index,
                position.X,
                position.Y,
                position.Z
            ),
            TextColor3 = ON_PRIMARY_CONTAINER,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            AutoButtonColor = false,
            LayoutOrder = index,
            ZIndex = 32,
        }, domainList)

        round(row, 8)

        local selectedCollider = entry.collider

        row.MouseButton1Click:Connect(function()
            teleportToCollider(selectedCollider)
        end)
    end

    noticePanel.Visible = true
end

