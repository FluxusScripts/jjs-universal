		Font = Enum.Font.GothamMedium,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)

	create("TextLabel", {
		Size = UDim2.new(1, -96, 0, 16),
		Position = UDim2.fromOffset(16, 36),
		BackgroundTransparency = 1,
		Text = sub,
		TextColor3 = ON_SURFACE_VARIANT,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)

	create("TextLabel", {
		Size = UDim2.new(1, -96, 0, 16),
		Position = UDim2.fromOffset(16, 54),
		BackgroundTransparency = 1,
		Text = sub2,
		TextColor3 = ON_SURFACE_VARIANT,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)

	local track = create("TextButton", {
		Size = UDim2.fromOffset(52, 32),
		Position = UDim2.new(1, -68, 0, 26),
		BackgroundColor3 = SURFACE_HIGHEST,
		Text = "",
		AutoButtonColor = false,
	}, row)

	round(track, 16)

	local stroke = create("UIStroke", {
		Color = OUTLINE,
		Thickness = 2,
	}, track)

	local knob = create("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = OUTLINE,
	}, track)

	round(knob, 12)

	local value = false

	local function render(animate)
		local duration = animate and 0.2 or 0

		tween(track, {
			BackgroundColor3 = value and PRIMARY or SURFACE_HIGHEST,
		}, duration)

		tween(knob, {
			Size = value
				and UDim2.fromOffset(24, 24)
				or UDim2.fromOffset(16, 16),

			Position = value
				and UDim2.fromOffset(24, 4)
				or UDim2.fromOffset(8, 8),

			BackgroundColor3 = value and ON_PRIMARY or OUTLINE,
		}, duration)

		stroke.Transparency = value and 1 or 0
	end

	track.MouseButton1Click:Connect(function()
		value = not value
		render(true)
		callback(value)
	end)

	render(false)

	return function(newValue)
		value = newValue
		render(false)
		callback(value)
	end
end

